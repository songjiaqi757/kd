# Large local assets: never commit datasets, model weights, caches, or run outputs.
/dataset/
/model/
/transfer/
# Run outputs stay local, except the text-only publication bundle of the MOSI ICD
# phase-2 campaign together with its orchestration scripts and audit records.
/outputs/*
!/outputs/experiments/
/outputs/experiments/*
!/outputs/experiments/icd_confirmatory_mosi_v1/
/outputs/experiments/icd_confirmatory_mosi_v1/*
!/outputs/experiments/icd_confirmatory_mosi_v1/*.py
!/outputs/experiments/icd_confirmatory_mosi_v1/*.json
!/outputs/experiments/icd_confirmatory_mosi_v1/*.md
!/outputs/experiments/icd_confirmatory_mosi_v1/publication/
!/outputs/experiments/icd_confirmatory_mosi_v1/preflight/
/outputs/experiments/icd_confirmatory_mosi_v1/preflight/*
!/outputs/experiments/icd_confirmatory_mosi_v1/preflight/phase0_complete.json

# Upstream repositories are cloned locally for source inspection and commit
# pinning.  Only their metadata and our clean-room adapters are versioned.
/external/original/

# Python-generated files.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments and editor/OS state.
.venv/
venv/
.idea/
.vscode/
.DS_Store
*.swp

# Common ML artifacts if generated outside outputs/.
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.npy
*.npz
*.h5
*.hdf5
*.parquet
wandb/
runs/

# Logs and temporary files.
*.log
*.tmp
*.bak
